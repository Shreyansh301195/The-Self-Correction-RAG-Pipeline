# =============================================================================
# Corrective RAG - Environment Variables
# =============================================================================

# --- LLM Configuration ---
# Option 1: OpenAI directly
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Option 2: OpenRouter (access open-source models like Mistral, LLaMA)
# OPENAI_API_KEY="your-openrouter-api-key-here"
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=mistralai/mistral-7b-instruct

# Option 3: Local Ollama (fully offline, no API key needed)
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2

# --- LangSmith Observability (optional but recommended) ---
LANGCHAIN_API_KEY="your-langsmith-api-key-here"
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=corrective-rag-telecom
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- RAG Parameters ---
TOP_K_RETRIEVAL=3
RELEVANCE_THRESHOLD=0.5
MAX_REWRITE_ATTEMPTS=2

# --- Vector DB ---
CHROMA_PERSIST_DIR=./chroma_db

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=../logs/app.log
